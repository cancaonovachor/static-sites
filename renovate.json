{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "Asia/Tokyo",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["cncn/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    }
  ]
}
